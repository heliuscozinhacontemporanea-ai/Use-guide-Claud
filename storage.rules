rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /content/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Documentos de verificação (D12): privados; só o backend lê, pelo Admin SDK.
    match /verification/{allPaths=**} {
      allow read, write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
