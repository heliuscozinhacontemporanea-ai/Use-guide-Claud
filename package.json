{
  "name": "use-guide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "26"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:emulators": "node scripts/dev/emulators.mjs",
    "dev:seed": "node scripts/dev/seed.mjs",
    "build": "NODE_ENV=production vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project notifications-rules-test 'npx vitest run --config vitest.rules.config.ts'",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "lint:fix": "biome check --write .",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:storage": "firebase deploy --only storage",
    "deploy:firebase-rules": "firebase deploy --only firestore:rules,storage",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:firestore": "firebase deploy --only firestore",
    "licenses": "node scripts/generate-licenses.mjs"
  },
  "dependencies": {
    "@google-cloud/kms": "6.3.0",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@stripe/connect-js": "^3.5.0",
    "@stripe/react-connect-js": "^3.5.0",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "date-fns": "^4.4.0",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "firebase": "^13.2.0",
    "firebase-admin": "14.5.0",
    "helmet": "^8.3.0",
    "i18next": "27.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.91.0",
    "react-i18next": "18.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.5"
    },
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
