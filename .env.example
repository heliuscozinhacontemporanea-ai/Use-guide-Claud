# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=your_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Required for Google Maps integration.
# Users should provide their own key from Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""


# Stripe Payment & Stripe Connect Config
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
# WhatsApp do suporte, em E.164 (ex: +5588999999999). Público; sem valor, o botão de WhatsApp do suporte não aparece.
VITE_SUPPORT_WHATSAPP=
STRIPE_WEBHOOK_SECRET=
# Taxas da plataforma (D14), obrigatórias para vender: percentuais em pontos-base (1500 = 15%) e taxa de serviço em centavos.
BOOKINGS_PLATFORM_FEE_BPS=1500
TICKETS_PLATFORM_FEE_BPS=1000
TICKETS_ABSORBED_FEE_BPS=1250
TICKET_SERVICE_FEE_MINOR=300
# Vagas de "Destaque" por lista no rodízio diário (D11); inteiro de 0 a 12, padrão 3.
FEATURED_SLOTS_PER_LIST=3

# Ticketing & Offline Check-In Cryptographic Keys & Scheduler Config
TICKET_QR_SECRET=
# Segredo anterior do HMAC do QR durante uma rotação (AGENTS.md §7.8); vazio fora de rotação.
TICKET_QR_SECRET_PREVIOUS=
OFFLINE_CHECKIN_PRIVATE_KEY_PEM=
OFFLINE_CHECKIN_KEY_ID=
# Jobs internos (Cloud Functions → Cloud Run /internal/*).
# Cloud Run: INTERNAL_JOB_KEY vem do Secret Manager.
# Functions: INTERNAL_JOB_KEY é o mesmo segredo (declarado em `secrets`); as URLs são parâmetros que o
# Firebase CLI pede no deploy e grava em functions/.env.<projeto>. Use a URL *.run.app, nunca a do Hosting,
# ex.: https://<serviço>.run.app/internal/bookings/expire. Este arquivo é só modelo: não grave valores reais.
INTERNAL_JOB_KEY=
TICKETING_EXPIRATION_JOB_URL=
BOOKINGS_EXPIRATION_JOB_URL=
BOOKINGS_COMPLETION_JOB_URL=
PARTNERS_EXPIRING_PLANS_JOB_URL=
PAYOUTS_RELEASE_JOB_URL=

# Firebase Client SDK Credentials & App Check Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-793FTL80F1
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Firebase Server Config
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
APP_CHECK_REQUIRED=false

# Proxies na frente do Express (AGENTS.md §7.4). Cloud Run atrás do Firebase Hosting: confira nos logs
# o X-Forwarded-For e ajuste. Obrigatório em produção; em desenvolvimento o padrão é 1.
TRUST_PROXY_HOPS=

# Insights: chave HMAC (≥ 32 caracteres) que pseudonimiza uid/IP na deduplicação de visualizações.
# Secret Manager em produção; chave diferente no AI Studio. Sem ela, /api/insights/track responde 503.
INSIGHTS_VIEWER_KEY=

# Criptografia de CPF/CNPJ por estabelecimento (AGENTS.md §7.7, decisão D12).
# Produção: nome completo da chave do Cloud KMS (projects/<p>/locations/<l>/keyRings/<r>/cryptoKeys/<k>);
# a conta de serviço do Cloud Run precisa de cloudkms.cryptoKeyEncrypterDecrypter só nessa chave.
FIELD_ENCRYPTION_KMS_KEY=
# AI Studio: 32 bytes aleatórios em base64 (ex.: openssl rand -base64 32). Recusada com NODE_ENV=production.
FIELD_ENCRYPTION_DEV_KEY=
# HMAC (≥ 32 caracteres) para checar documento repetido sem gravar o número. Trocar exige reindexar.
PII_BLIND_INDEX_KEY=
