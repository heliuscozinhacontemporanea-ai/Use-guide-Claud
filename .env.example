# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=your_key_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Required for Google Maps integration.
# Users should provide their own key from Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=""

# Cloudinary Config
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Stripe Payment & Stripe Connect Config
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_ACCOUNT_ID=
USE_GUIDE_PLATFORM_FEE_PERCENT=10

# Ticketing & Offline Check-In Cryptographic Keys & Scheduler Config
TICKET_QR_SECRET=
# Segredo anterior do HMAC do QR durante uma rotação (AGENTS.md §7.8); vazio fora de rotação.
TICKET_QR_SECRET_PREVIOUS=
OFFLINE_CHECKIN_PRIVATE_KEY_PEM=
OFFLINE_CHECKIN_KEY_ID=
TICKET_QR_PRIVATE_KEY_PEM=
TICKET_QR_PUBLIC_KEY_PEM=
TICKETING_EXPIRATION_JOB_KEY=
TICKETING_EXPIRATION_JOB_URL=

# Firebase Client SDK Credentials & App Check Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=G-793FTL80F1
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Firebase Server Config
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
APP_CHECK_REQUIRED=false
